
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <title>Bài 1 - Bố cục Table</title>
</head>
<body>
    <table border="1" width="800" height="600" cellpadding="10" cellspacing="0">
        <!-- Dòng 1 -->
        <tr>
            <!-- Cột trái: Danh sách liên kết gộp 3 dòng -->
            <td rowspan="3" width="25%" valign="top">
                <h3>danh sách các mục liên kết</h3>
                <ul>
                    <li>Mục 1</li>
                    <li>Mục 2</li>
                    <li>Mục 3</li>
                    <li>Mục 4</li>
                </ul>
            </td>
            <!-- Logo gộp 2 cột -->
            <td colspan="2" height="20%" valign="top">
                <h2>Logo</h2>
            </td>
        </tr>
        <!-- Dòng 2 -->
        <tr>
            <!-- Nội dung 1 gộp 2 dòng -->
            <td rowspan="2" width="40%" valign="top">
                <h3>Nội dung 1</h3>
                <p>~~~~</p>
                <p>~~~~</p>
                <p>~~~~</p>
                <p>~~~~</p>
                <p>~~~~</p>
                <p>~~~~</p>
                <div style="width: 100px; height: 100px; border: 1px solid black; float: right;"></div>
            </td>
            <!-- Nội dung 2 -->
            <td valign="top">
                <h3>Nội dung 2</h3>
                <ul>
                    <li>~~~~</li>
                    <li>~~~~</li>
                    <li>~~~~</li>
                    <li>~~~~</li>
                    <li>~~~~</li>
                </ul>
            </td>
        </tr>
        <!-- Dòng 3 -->
        <tr>
            <!-- Nội dung 3 -->
            <td valign="top">
                <h3>Nội dung 3</h3>
                <p>~~~~</p>
                <p>~~~~</p>
                <p>~~~~</p>
                <p>~~~~</p>

                <div style="width: 80px; height: 80px; border: 1px solid black; float: right;"></div>
            </td>
        </tr>
    </table>
</body>
</html>